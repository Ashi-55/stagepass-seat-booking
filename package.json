    "@angular/forms": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.7.0-beta.19",
    "esbuild": "0.28.2",
