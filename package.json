{
  "name": "cardy",
  "version": "1.0.0",
  "description": "Stagepass is a local event booking app. Attendees choose numbered seats, hold them with a countdown, confirm a booking, and cancel from their personal history. Organizers configure each event independently.",
  "main": "index.js",
  "scripts": {
    "test": "node --test scripts/booking.test.mjs",
    "build": "tsc && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "local": "node scripts/local.mjs",
    "test:browser": "node scripts/check-live.mjs"
  },
